{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoSys",
  "version": "0.1.0",
  "identifier": "com.photosys.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PhotoSys",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:; media-src 'self' blob:",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/photosys-ffmpeg"],
    "resources": {
      "binaries/onnxruntime/": "onnxruntime/",
      "binaries/media-codec-licenses/": "media-codec-licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
